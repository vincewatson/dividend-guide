# Cloudflare Pages 响应头（2026-10-03 从 vercel.json 迁移）
# 与 Vercel 版保持一致：HTML 不缓存、blog/data 走协商缓存

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

# 红利机会值子页（2026-10-08 修复：此前未列规则 → HTML 与 data/*.js 均落 Cloudflare 默认 max-age=14400，
#   iframe 单独请求 data/opportunity.js 时浏览器可缓存旧数据最长 4h，页面显示旧文案/缺计算口径）
/红利机会值/
  Cache-Control: no-cache, no-store, must-revalidate

/红利机会值/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/红利机会值/data/*
  Cache-Control: public, max-age=0, must-revalidate
